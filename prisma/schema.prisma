generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  WISHLIST
  APPLIED
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
}

enum WorkMode {
  REMOTE
  HYBRID
  ON_SITE
}

enum EmploymentType {
  INTERNSHIP
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  OTHER
}

enum ApplicationSource {
  LINKEDIN
  COMPANY_WEBSITE
  GREENHOUSE
  LEVER
  ASHBY
  REFERRAL
  OTHER
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Application {
  id             String                     @id @default(cuid())
  userId         String
  slug           String
  company        String
  role           String
  description    String?                    @db.Text
  status         ApplicationStatus          @default(WISHLIST)
  location       String?
  workMode       WorkMode?
  employmentType EmploymentType?
  source         ApplicationSource?
  applicationUrl String?
  salaryMin      Int?
  salaryMax      Int?
  currency       String?
  deadline       DateTime?
  appliedAt      DateTime?
  matchScore     Int?
  requiredSkills String[]                   @default([])
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  statusHistory  ApplicationStatusHistory[]
  notes          ApplicationNote[]
  reminders      ApplicationReminder[]
  materials      ApplicationMaterial[]
  resumeVersions ApplicationResumeVersion[]
  resumeMatches  ApplicationResumeMatch[]
  interviews     ApplicationInterview[]

  @@unique([userId, slug])
  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt])
}

model ApplicationStatusHistory {
  id            String             @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedAt     DateTime           @default(now())
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([applicationId, changedAt])
}

model ApplicationNote {
  id            String      @id @default(cuid())
  applicationId String
  content       String      @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model ApplicationReminder {
  id            String                @id @default(cuid())
  applicationId String
  title         String
  remindAt      DateTime
  completedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  application   Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interview     ApplicationInterview?

  @@index([applicationId, remindAt])
  @@index([completedAt, remindAt])
}

model ApplicationInterview {
  id                    String               @id @default(cuid())
  applicationId         String
  title                 String
  roundNumber           Int
  scheduledAt           DateTime
  durationMinutes       Int                  @default(60)
  interviewerName       String?
  interviewerRole       String?
  location              String?
  meetingUrl            String?
  status                InterviewStatus      @default(SCHEDULED)
  completedAt           DateTime?
  reminderMinutesBefore Int?
  reminderId            String?              @unique
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  application           Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reminder              ApplicationReminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@index([applicationId, scheduledAt])
  @@index([status, scheduledAt])
}

model ApplicationMaterial {
  id                 String       @id @default(cuid())
  applicationId      String
  resumeDraftId      String?
  resumeTitle        String
  coverLetter        String       @db.Text
  followUpMessage    String       @db.Text
  interviewQuestions Json
  isSubmitted        Boolean      @default(false)
  submittedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  application        Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  resumeDraft        ResumeDraft? @relation(fields: [resumeDraftId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([applicationId, isSubmitted])
  @@index([resumeDraftId])
}

model ResumeDraft {
  id                   String                     @id @default(cuid())
  userId               String
  title                String
  language             String
  content              Json
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  applicationMaterials ApplicationMaterial[]
  applicationVersions  ApplicationResumeVersion[] @relation("ResumeVersionSource")
  tailoredMatches      ApplicationResumeMatch[]   @relation("TailoredResumeDraft")

  @@index([userId])
  @@index([userId, updatedAt])
}

model ApplicationResumeVersion {
  id                  String                  @id @default(cuid())
  applicationId       String
  sourceResumeDraftId String?
  resumeTitle         String
  resumeContent       Json
  jobTitle            String
  company             String
  jobDescription      String                  @db.Text
  requiredSkills      String[]                @default([])
  isSubmitted         Boolean                 @default(false)
  submittedAt         DateTime?
  createdAt           DateTime                @default(now())
  application         Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sourceResumeDraft   ResumeDraft?            @relation("ResumeVersionSource", fields: [sourceResumeDraftId], references: [id], onDelete: SetNull)
  match               ApplicationResumeMatch?

  @@index([applicationId, createdAt])
  @@index([applicationId, isSubmitted])
  @@index([sourceResumeDraftId])
}

model ApplicationResumeMatch {
  id                        String                   @id @default(cuid())
  applicationId             String
  resumeVersionId           String                   @unique
  result                    Json
  acceptedSuggestionIndexes Int[]                    @default([])
  rejectedSuggestionIndexes Int[]                    @default([])
  provider                  String?
  model                     String?
  tailoredResumeDraftId     String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  application               Application              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  resumeVersion             ApplicationResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
  tailoredResumeDraft       ResumeDraft?             @relation("TailoredResumeDraft", fields: [tailoredResumeDraftId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([tailoredResumeDraftId])
}

model SavedResumeAnalysis {
  id                        String    @id @default(cuid())
  userId                    String
  fileName                  String
  originalFile              Bytes?
  originalMimeType          String?
  originalFileSize          Int?
  provider                  String?
  model                     String?
  characterCount            Int?
  analysis                  Json
  importedDraft             Json?
  appliedImprovementIndexes Int[]     @default([])
  draftImportedAt           DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([userId])
  @@index([userId, updatedAt])
}
