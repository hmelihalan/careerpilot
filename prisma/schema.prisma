generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  WISHLIST
  APPLIED
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
}

enum WorkMode {
  REMOTE
  HYBRID
  ON_SITE
}

enum EmploymentType {
  INTERNSHIP
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  OTHER
}

enum ApplicationSource {
  LINKEDIN
  COMPANY_WEBSITE
  GREENHOUSE
  LEVER
  ASHBY
  REFERRAL
  OTHER
}

model Application {
  id             String                     @id @default(cuid())
  userId         String
  slug           String
  company        String
  role           String
  description    String?                    @db.Text
  status         ApplicationStatus          @default(WISHLIST)
  location       String?
  workMode       WorkMode?
  employmentType EmploymentType?
  source         ApplicationSource?
  applicationUrl String?
  salaryMin      Int?
  salaryMax      Int?
  currency       String?
  deadline       DateTime?
  appliedAt      DateTime?
  matchScore     Int?
  requiredSkills String[]                   @default([])
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  statusHistory  ApplicationStatusHistory[]
  notes          ApplicationNote[]
  reminders      ApplicationReminder[]
  material       ApplicationMaterial?

  @@unique([userId, slug])
  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt])
}

model ApplicationStatusHistory {
  id            String             @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedAt     DateTime           @default(now())
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([applicationId, changedAt])
}

model ApplicationNote {
  id            String      @id @default(cuid())
  applicationId String
  content       String      @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model ApplicationReminder {
  id            String      @id @default(cuid())
  applicationId String
  title         String
  remindAt      DateTime
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, remindAt])
  @@index([completedAt, remindAt])
}

model ApplicationMaterial {
  id                 String      @id @default(cuid())
  applicationId      String      @unique
  resumeDraftId      String?
  resumeTitle        String
  coverLetter        String      @db.Text
  followUpMessage    String      @db.Text
  interviewQuestions Json
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  application        Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  resumeDraft        ResumeDraft? @relation(fields: [resumeDraftId], references: [id], onDelete: SetNull)

  @@index([resumeDraftId])
}

model ResumeDraft {
  id        String   @id @default(cuid())
  userId    String
  title     String
  language  String
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  applicationMaterials ApplicationMaterial[]

  @@index([userId])
  @@index([userId, updatedAt])
}

model SavedResumeAnalysis {
  id                        String    @id @default(cuid())
  userId                    String    @unique
  fileName                  String
  originalFile              Bytes?
  originalMimeType          String?
  originalFileSize          Int?
  analysis                  Json
  importedDraft             Json?
  appliedImprovementIndexes Int[]     @default([])
  draftImportedAt           DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([userId])
}
